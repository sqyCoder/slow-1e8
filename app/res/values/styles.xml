<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      为什么必须自定义主题：
      1) 默认主题带 ActionBar，会额外显示一条「慢亿点」标题栏，和应用内自绘的顶栏重复，
         还会多占掉 56dp 高度（小屏上正是这一条把下面挤出去了）。
      2) 默认窗口底色是浅色/主题色，Android 12+ 的系统启动画面也跟着它走，
         于是「系统启动画面 → 自绘动画」之间会有一个 0.x 秒的底色跳变，
         看起来像动画播完还留了东西。
      把窗口底色、状态栏、系统启动画面底色统一成 ground，三段接起来是连续的。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- API 31+ 的系统启动画面：底色跟自绘动画一致，图标做成透明 -->
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

</resources>
